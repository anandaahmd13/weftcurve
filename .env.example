APP_NETWORK=simulator
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://weft:weft-local-only@127.0.0.1:55432/weftcurve_simulator
# A separate database is mandatory for devnet. Mainnet is unsupported.
# APP_NETWORK=devnet
# DATABASE_URL=postgresql://weft:weft-local-only@127.0.0.1:55432/weftcurve_devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EPOCH_SECONDS=300

# Devnet launch stays disabled unless all values below are configured.
# ENABLE_DEVNET_TRANSACTIONS=true
# DEVNET_PARTNER_PUBLIC_KEY=<partner fee-claimer public key>
# DEVNET_KEYS_DIR=/absolute/private/path/outside-this-repository

# Devnet payouts remain disabled until separately reviewed and configured.
# ENABLE_DEVNET_REWARDS=true
# DEVNET_FEE_PAYER_FILE=/absolute/private/path/devnet-fee-payer.json
